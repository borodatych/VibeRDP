+BOOL transport_can_write(rdpTransport* transport, int timeoutMs)
+{
+	WINPR_ASSERT(transport);
+
+	BIO* bio = transport->frontBio;
+	if (!bio)
+		return TRUE;
+	if (BIO_wpending(bio) > 0)
+		return FALSE;
+
+	int fd = -1;
+	if ((BIO_get_fd(bio, &fd) <= 0) || (fd < 0))
+		return TRUE;
+
+	struct pollfd pfd = { .fd = fd, .events = POLLOUT, .revents = 0 };
+	return (poll(&pfd, 1, timeoutMs) == 1) && ((pfd.revents & POLLOUT) != 0);
+}
+
