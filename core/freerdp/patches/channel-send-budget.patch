+	if (freerdp_settings_get_bool(settings, FreeRDP_ServerMode))
+		return FALSE;
+	if ((freerdp_settings_get_uint32(settings, FreeRDP_VCFlags) & VCCAPS_COMPR_CS_8K) == 0)
+		return FALSE;
+	if ((channel->options & (CHANNEL_OPTION_COMPRESS_RDP | CHANNEL_OPTION_COMPRESS)) == 0)
+		return FALSE;
