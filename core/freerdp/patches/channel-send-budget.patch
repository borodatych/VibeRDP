-static BOOL freerdp_channels_process_message(freerdp* instance, wMessage* message)
+/*
+ * The bytes a pass of the session loop sends at most: a message of megabytes, a large clipboard answer,
+ * goes out over many passes, and the loop reads the server and sends input between them
+ */
+#define CHANNEL_SEND_BUDGET (64ull * 1024ull)
+
+/* *done is FALSE while a part of the message is still to go: it stays in the queue, not freed */
+static BOOL freerdp_channels_process_message(freerdp* instance, wMessage* message, BOOL* done)
 {
 	BOOL ret = TRUE;
 	BOOL rc = FALSE;
@@ -735,17 +745,28 @@ static BOOL freerdp_channels_process_message(freerdp* instance, wMessage* messag
 
 		if (channel)
 		{
