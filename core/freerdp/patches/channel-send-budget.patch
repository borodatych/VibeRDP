+static BOOL channel_send_chunk(rdpRdp* rdp, UINT16 channelId, size_t totalSize, UINT32 flags,
+                               const BYTE* data, size_t chunkSize, BOOL compress, size_t* wire)
+{
+	BYTE buffer[CHANNEL_COMPRESS_MAX_CHUNK];
+	const BYTE* out = data;
+	UINT32 outSize = (UINT32)chunkSize;
+
+	if (compress && (chunkSize <= sizeof(buffer)))
+	{
+		UINT32 mppcFlags = 0;
+		outSize = (UINT32)sizeof(buffer);
+		if (mppc_compress(rdp->channelCompressor, data, (UINT32)chunkSize, buffer, &out, &outSize,
+		                  &mppcFlags) < 0)
+			return FALSE;
+		flags |= (mppcFlags & 0xFF) << 16;
+	}
+	if (wire)
+		*wire += outSize;
+	return freerdp_channel_send_packet(rdp, channelId, totalSize, flags, out, outSize);
+}
