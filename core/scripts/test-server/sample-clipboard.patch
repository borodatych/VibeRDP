+/**
+ * Test tool of VibeRDP: an echo of the clipboard of the client
+ * The server asks for every text the client offers and offers it back behind a prefix
+ * A client test so sees its text make the round trip through both directions of the channel
+ */
+
+#include <freerdp/config.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <winpr/assert.h>
+#include <winpr/user.h>
+
+#include "sf_cliprdr.h"
+
+#define ECHO_PREFIX "echo: "
+
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_client_format_list(CliprdrServerContext* context,
+                                          const CLIPRDR_FORMAT_LIST* formatList)
+{
+	const CLIPRDR_FORMAT_LIST_RESPONSE response = {
+		.common = { .msgType = CB_FORMAT_LIST_RESPONSE, .msgFlags = CB_RESPONSE_OK }
+	};
+	const UINT rc = context->ServerFormatListResponse(context, &response);
+	if (rc != CHANNEL_RC_OK)
+		return rc;
+
+	for (UINT32 i = 0; i < formatList->numFormats; i++)
+	{
+		if (formatList->formats[i].formatId == CF_UNICODETEXT)
+		{
+			const CLIPRDR_FORMAT_DATA_REQUEST request = {
+				.common = { .msgType = CB_FORMAT_DATA_REQUEST }, .requestedFormatId = CF_UNICODETEXT
+			};
+			return context->ServerFormatDataRequest(context, &request);
+		}
+	}
+	return CHANNEL_RC_OK;
+}
+
+/* The text of the client comes back as the clipboard of the server, behind the prefix */
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_client_format_data_response(CliprdrServerContext* context,
+                                                   const CLIPRDR_FORMAT_DATA_RESPONSE* response)
+{
+	testPeerContext* peer = context->custom;
+	WINPR_ASSERT(peer);
+
+	if ((response->common.msgFlags & CB_RESPONSE_OK) == 0)
+		return CHANNEL_RC_OK;
+
+	const size_t prefixLength = strlen(ECHO_PREFIX);
+	const size_t length = 2 * prefixLength + response->common.dataLen;
+	BYTE* clipboard = malloc(length);
+	if (!clipboard)
+		return CHANNEL_RC_NO_MEMORY;
+	for (size_t i = 0; i < prefixLength; i++)
+	{
+		clipboard[2 * i] = (BYTE)ECHO_PREFIX[i];
+		clipboard[2 * i + 1] = 0;
+	}
+	memcpy(clipboard + 2 * prefixLength, response->requestedFormatData, response->common.dataLen);
+	free(peer->clipboard);
+	peer->clipboard = clipboard;
+	peer->clipboardLength = (UINT32)length;
+
+	CLIPRDR_FORMAT format = { .formatId = CF_UNICODETEXT };
+	const CLIPRDR_FORMAT_LIST list = { .common = { .msgType = CB_FORMAT_LIST },
+		                               .numFormats = 1,
+		                               .formats = &format };
+	return context->ServerFormatList(context, &list);
+}
+
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_client_format_data_request(CliprdrServerContext* context,
+                                                  const CLIPRDR_FORMAT_DATA_REQUEST* request)
+{
+	testPeerContext* peer = context->custom;
+	WINPR_ASSERT(peer);
+
+	const BOOL have = (request->requestedFormatId == CF_UNICODETEXT) && peer->clipboard;
+	const CLIPRDR_FORMAT_DATA_RESPONSE response = {
+		.common = { .msgType = CB_FORMAT_DATA_RESPONSE,
+		            .msgFlags = have ? CB_RESPONSE_OK : CB_RESPONSE_FAIL,
+		            .dataLen = have ? peer->clipboardLength : 0 },
+		.requestedFormatData = have ? peer->clipboard : nullptr
+	};
+	return context->ServerFormatDataResponse(context, &response);
+}
+
+BOOL sf_peer_cliprdr_init(testPeerContext* context)
+{
+	WINPR_ASSERT(context);
+
+	context->cliprdr = cliprdr_server_context_new(context->vcm);
+	if (!context->cliprdr)
+		return FALSE;
+
+	context->cliprdr->rdpcontext = &context->_p;
+	context->cliprdr->custom = context;
+	context->cliprdr->useLongFormatNames = TRUE;
+	context->cliprdr->ClientFormatList = sf_cliprdr_client_format_list;
+	context->cliprdr->ClientFormatDataRequest = sf_cliprdr_client_format_data_request;
+	context->cliprdr->ClientFormatDataResponse = sf_cliprdr_client_format_data_response;
+
+	WINPR_ASSERT(context->cliprdr->Start);
+	return (context->cliprdr->Start(context->cliprdr) == CHANNEL_RC_OK);
+}
+
+void sf_peer_cliprdr_uninit(testPeerContext* context)
+{
+	WINPR_ASSERT(context);
+
+	if (context->cliprdr)
+	{
+		WINPR_ASSERT(context->cliprdr->Stop);
+		(void)context->cliprdr->Stop(context->cliprdr);
+		cliprdr_server_context_free(context->cliprdr);
+		context->cliprdr = nullptr;
+	}
+	free(context->clipboard);
+	context->clipboard = nullptr;
+}
