+/**
+ * Test tool of VibeRDP: an echo of the clipboard of the client
+ * The server asks for the text, HTML, RTF and CF_DIB the client offers and offers them back,
+ * the text behind a prefix and the rest as it came
+ * A client test so sees its data make the round trip through both directions of the channel
+ */
+
+#include <freerdp/config.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <winpr/assert.h>
+#include <winpr/user.h>
+
+#include "sf_cliprdr.h"
+
+#define ECHO_PREFIX "echo: "
+
+/* The ids this server gives the formats in its own lists; registered formats go by their names */
+static const UINT32 echo_ids[SF_CLIPBOARD_KINDS] = { CF_UNICODETEXT, 0xC100, 0xC101, CF_DIB };
+static const char* const echo_names[SF_CLIPBOARD_KINDS] = { nullptr, "HTML Format",
+	                                                        "Rich Text Format", nullptr };
+
+static int sf_cliprdr_kind(const CLIPRDR_FORMAT* format)
+{
+	for (int kind = 0; kind < SF_CLIPBOARD_KINDS; kind++)
+	{
+		if (echo_names[kind] ? (format->formatName && strcmp(format->formatName, echo_names[kind]) == 0)
+		                     : format->formatId == echo_ids[kind])
+			return kind;
+	}
+	return -1;
+}
+
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_request_next(CliprdrServerContext* context, testPeerContext* peer)
+{
+	const CLIPRDR_FORMAT_DATA_REQUEST request = {
+		.common = { .msgType = CB_FORMAT_DATA_REQUEST },
+		.requestedFormatId = peer->clipboard_wanted_ids[peer->clipboard_wanted_next]
+	};
+	return context->ServerFormatDataRequest(context, &request);
+}
+
+/* All the client offered came over: the server offers it back */
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_offer_back(CliprdrServerContext* context, testPeerContext* peer)
+{
+	CLIPRDR_FORMAT formats[SF_CLIPBOARD_KINDS] = WINPR_C_ARRAY_INIT;
+	UINT32 count = 0;
+
+	for (int kind = 0; kind < SF_CLIPBOARD_KINDS; kind++)
+	{
+		if (peer->clipboard[kind])
+		{
+			formats[count].formatId = echo_ids[kind];
+			formats[count].formatName = (char*)echo_names[kind];
+			count++;
+		}
+	}
+	const CLIPRDR_FORMAT_LIST list = { .common = { .msgType = CB_FORMAT_LIST },
+		                               .numFormats = count,
+		                               .formats = formats };
+	return context->ServerFormatList(context, &list);
+}
+
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_client_format_list(CliprdrServerContext* context,
+                                          const CLIPRDR_FORMAT_LIST* formatList)
+{
+	testPeerContext* peer = context->custom;
+	WINPR_ASSERT(peer);
+
+	const CLIPRDR_FORMAT_LIST_RESPONSE response = {
+		.common = { .msgType = CB_FORMAT_LIST_RESPONSE, .msgFlags = CB_RESPONSE_OK }
+	};
+	const UINT rc = context->ServerFormatListResponse(context, &response);
+	if (rc != CHANNEL_RC_OK)
+		return rc;
+
+	for (int kind = 0; kind < SF_CLIPBOARD_KINDS; kind++)
+	{
+		free(peer->clipboard[kind]);
+		peer->clipboard[kind] = nullptr;
+		peer->clipboard_length[kind] = 0;
+	}
+	peer->clipboard_wanted_count = 0;
+	peer->clipboard_wanted_next = 0;
+	for (UINT32 i = 0; i < formatList->numFormats; i++)
+	{
+		const int kind = sf_cliprdr_kind(&formatList->formats[i]);
+		if (kind >= 0 && peer->clipboard_wanted_count < SF_CLIPBOARD_KINDS)
+		{
+			peer->clipboard_wanted_ids[peer->clipboard_wanted_count] =
+			    formatList->formats[i].formatId;
+			peer->clipboard_wanted_kinds[peer->clipboard_wanted_count] = kind;
+			peer->clipboard_wanted_count++;
+		}
+	}
+	if (peer->clipboard_wanted_count == 0)
+		return CHANNEL_RC_OK;
+	return sf_cliprdr_request_next(context, peer);
+}
+
+/* One format came over; the next one is asked for, or everything goes back when none is left */
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_client_format_data_response(CliprdrServerContext* context,
+                                                   const CLIPRDR_FORMAT_DATA_RESPONSE* response)
+{
+	testPeerContext* peer = context->custom;
+	WINPR_ASSERT(peer);
+
+	if (peer->clipboard_wanted_next >= peer->clipboard_wanted_count)
+		return CHANNEL_RC_OK;
+
+	const int kind = peer->clipboard_wanted_kinds[peer->clipboard_wanted_next];
+	if (response->common.msgFlags & CB_RESPONSE_OK)
+	{
+		const size_t prefix = (kind == 0) ? strlen(ECHO_PREFIX) : 0;
+		const size_t length = 2 * prefix + response->common.dataLen;
+		BYTE* data = malloc(length);
+		if (!data)
+			return CHANNEL_RC_NO_MEMORY;
+		for (size_t i = 0; i < prefix; i++)
+		{
+			data[2 * i] = (BYTE)ECHO_PREFIX[i];
+			data[2 * i + 1] = 0;
+		}
+		memcpy(data + 2 * prefix, response->requestedFormatData, response->common.dataLen);
+		peer->clipboard[kind] = data;
+		peer->clipboard_length[kind] = (UINT32)length;
+	}
+
+	peer->clipboard_wanted_next++;
+	if (peer->clipboard_wanted_next < peer->clipboard_wanted_count)
+		return sf_cliprdr_request_next(context, peer);
+	return sf_cliprdr_offer_back(context, peer);
+}
+
+WINPR_ATTR_NODISCARD
+static UINT sf_cliprdr_client_format_data_request(CliprdrServerContext* context,
+                                                  const CLIPRDR_FORMAT_DATA_REQUEST* request)
+{
+	testPeerContext* peer = context->custom;
+	WINPR_ASSERT(peer);
+
+	int found = -1;
+	for (int kind = 0; kind < SF_CLIPBOARD_KINDS; kind++)
+		if (echo_ids[kind] == request->requestedFormatId && peer->clipboard[kind])
+			found = kind;
+
+	const CLIPRDR_FORMAT_DATA_RESPONSE response = {
+		.common = { .msgType = CB_FORMAT_DATA_RESPONSE,
+		            .msgFlags = (found >= 0) ? CB_RESPONSE_OK : CB_RESPONSE_FAIL,
+		            .dataLen = (found >= 0) ? peer->clipboard_length[found] : 0 },
+		.requestedFormatData = (found >= 0) ? peer->clipboard[found] : nullptr
+	};
+	return context->ServerFormatDataResponse(context, &response);
+}
+
+BOOL sf_peer_cliprdr_init(testPeerContext* context)
+{
+	WINPR_ASSERT(context);
+
+	context->cliprdr = cliprdr_server_context_new(context->vcm);
+	if (!context->cliprdr)
+		return FALSE;
+
+	context->cliprdr->rdpcontext = &context->_p;
+	context->cliprdr->custom = context;
+	context->cliprdr->useLongFormatNames = TRUE;
+	context->cliprdr->ClientFormatList = sf_cliprdr_client_format_list;
+	context->cliprdr->ClientFormatDataRequest = sf_cliprdr_client_format_data_request;
+	context->cliprdr->ClientFormatDataResponse = sf_cliprdr_client_format_data_response;
+
+	WINPR_ASSERT(context->cliprdr->Start);
+	return (context->cliprdr->Start(context->cliprdr) == CHANNEL_RC_OK);
+}
+
+void sf_peer_cliprdr_uninit(testPeerContext* context)
+{
+	WINPR_ASSERT(context);
+
+	if (context->cliprdr)
+	{
+		WINPR_ASSERT(context->cliprdr->Stop);
+		(void)context->cliprdr->Stop(context->cliprdr);
+		cliprdr_server_context_free(context->cliprdr);
+		context->cliprdr = nullptr;
+	}
+	for (int kind = 0; kind < SF_CLIPBOARD_KINDS; kind++)
+	{
+		free(context->clipboard[kind]);
+		context->clipboard[kind] = nullptr;
+	}
+}
