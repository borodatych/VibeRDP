# Build parameters shared by the build scripts of the core and the macOS client and by CI
# Sourced by POSIX shells: KEY=value lines only, no expansions

# Product version: the macOS app and the core framework carry the same one
VERSION=0.1.0

# Oldest macOS the product supports: every compiled component targets it
MACOSX_DEPLOYMENT_TARGET=14.0

# Slices of the universal binaries
ARCHS="arm64 x86_64"

# CMake build type of FreeRDP
BUILD_TYPE=Release

# OpenSSL 3.5 is the LTS series, supported until 2030-04-08
# The checksum comes from a release whose PGP signature was verified: docs/knowledge/freerdp/buildMacOS.md
OPENSSL_VERSION=3.5.8
OPENSSL_SHA256=a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2

# FreeRDP client channels compiled in; every other channel of the submodule is disabled
FREERDP_CHANNELS="cliprdr rail disp rdpgfx drdynvc"

# Prefix baked into the libraries: FreeRDP plugins and the OpenSSL config and CA store are looked up under it
# Only root can create it, so no user can plant files there; the build installs elsewhere through DESTDIR
RUNTIME_PREFIX=/opt/viberdp
